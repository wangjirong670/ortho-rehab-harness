# ==============================================================================
# OrthoRehab-TCM-Harness 模型配置模板（基于 LiteLLM 统一多模型路由）
# 使用方式：复制为 .env 后填入实际 Key（.env 已被 .gitignore 忽略，切勿提交）
# ==============================================================================

# ---------- 1. 默认运行时配置 ----------
# 副驾默认模型（示例：deepseek/deepseek-chat、openai/gpt-4o-mini、dashscope/qwen-plus、zai/glm-4-plus）
COPILOT_DEFAULT_MODEL=deepseek/deepseek-chat

# 评测沙箱默认对比模型列表（逗号分隔）
BENCHMARK_MODELS=deepseek/deepseek-chat,dashscope/qwen-plus,openai/gpt-4o-mini

# 裁判模型（可选，仅用于非红线维度的结构化辅助打分；硬红线始终走 Python 确定性判定）
JUDGE_MODEL=deepseek/deepseek-chat

# 设为 true 可在无 API Key 时使用本地 Mock 客户端调试界面与流程
LLM_MOCK_MODE=false

# ---------- 2. 国内主流模型 API Key ----------
# DeepSeek (模型名示例: deepseek/deepseek-chat, deepseek/deepseek-reasoner)
DEEPSEEK_API_KEY=

# 阿里云百炼 / 通义千问 (模型名示例: dashscope/qwen-plus, dashscope/qwen-max)
DASHSCOPE_API_KEY=

# 智谱 GLM (模型名示例: zai/glm-4-plus 或 openai/glm-4-plus 配合自定义 base_url)
ZHIPUAI_API_KEY=

# 月之暗面 Kimi (OpenAI 兼容，模型名示例: moonshot/moonshot-v1-8k)
MOONSHOT_API_KEY=

# ---------- 3. 国际主流模型 / OpenAI 兼容中转 ----------
OPENAI_API_KEY=
# 若使用中转站或本地 vLLM/Ollama OpenAI 兼容端点，可设置以下地址
OPENAI_API_BASE=

# Anthropic Claude (模型名示例: anthropic/claude-3-5-sonnet-latest)
ANTHROPIC_API_KEY=

# Google Gemini (模型名示例: gemini/gemini-2.5-pro)
GEMINI_API_KEY=

# ---------- 4. 通用请求参数 ----------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
