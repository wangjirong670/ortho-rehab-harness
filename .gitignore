# Secrets & local env (preserve .env.example)
.env
.env.*
!.env.example
*.secret
.streamlit/secrets.toml
*.pem
*.key

# Private benchmark cases (anti-leakage isolation)
app_benchmark/test_cases/private/*
!app_benchmark/test_cases/private/README.md
!app_benchmark/test_cases/private/.gitkeep
app_benchmark/outputs/
app_benchmark/reports/
# Benchmark run artifacts & runtime user data
app_benchmark/results/
results/
logs/
custom_cases/

# Frontend build & dependencies
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
release_artifacts/
*.spec
*.egg-info/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
